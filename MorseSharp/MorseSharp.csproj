<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(TF_BUILD)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>MorseSharp</PackageId>
    <Title>MorseSharp</Title>
    <Version>6.1.0</Version>
    <Authors>p0laris</Authors>
    <Description>A fast, allocation-free .NET library for Morse code in 11 languages (including Kurdish): encode/decode text, generate or decode WAV audio, drive or read a blinking light, key input from an iambic paddle, define custom alphabets, and generate Koch-method lessons and practice traffic.</Description>
    <PackageProjectUrl>https://github.com/p6laris/MorseSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/p6laris/MorseSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>MorseCode;Morse;Converter;MorseKurdish;KurdishLanguage;MorseSharp;Wav;Audio;Farnsworth</PackageTags>
    <NeutralLanguage>en-GB</NeutralLanguage>
    <Copyright>Copyright (c) 2022-2026 p0laris</Copyright>
    <PackageIcon>MorseSharp.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>See CHANGELOG.md in the repository.</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\MorseSharp.png" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MorseTest" />
    <InternalsVisibleTo Include="Benchmark" />
  </ItemGroup>

  <!-- The alphabet tables are packed at build time from the .morse files by the generator. -->
  <ItemGroup>
    <ProjectReference Include="..\MorseSharp.Generators\MorseSharp.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="Alphabet\Data\*.morse" />
  </ItemGroup>
</Project>
